[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/inventory_panel.gd" id="1_inventory_panel_script"]

[node name="InventoryPanel" type="PanelContainer"]
process_mode = 3
visible = false
offset_left = 20.0
offset_top = 350.0
offset_right = 700.0
offset_bottom = 1000.0
script = ExtResource("1_inventory_panel_script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 10

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Header" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2

[node name="TitleLabel" type="Label" parent="Margin/VBox/Header"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 24
text = "Inventory"

[node name="CloseButton" type="Button" parent="Margin/VBox/Header"]
custom_minimum_size = Vector2(150, 54)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 20
text = "Close"

[node name="CapacityLabel" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Equipment items: 0 / 20"

[node name="ItemList" type="ItemList" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 210)
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/line_separation = 18
theme_override_font_sizes/font_size = 22
select_mode = 0

[node name="SelectedItemLabel" type="Label" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 34)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Select an item, then tap Equip Selected."
text_overrun_behavior = 3

[node name="EquipSelectedButton" type="Button" parent="Margin/VBox"]
custom_minimum_size = Vector2(0, 58)
layout_mode = 2
focus_mode = 0
theme_override_font_sizes/font_size = 22
text = "Equip Selected"
disabled = true

[node name="Separator" type="HSeparator" parent="Margin/VBox"]
layout_mode = 2

[node name="EquippedTitle" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Currently Equipped"

[node name="EquippedSlots" type="GridContainer" parent="Margin/VBox"]
layout_mode = 2
